# Build outputs and caches — regenerated by Gradle/Android Studio, never worth tracking.
*.iml
.gradle
.kotlin
build/
/captures
.externalNativeBuild
.cxx

# IDE project state — machine-specific; let Android Studio regenerate it.
/.idea/

# Local machine config. Holds this build's real OpenRouteService key (see AGENTS.md
# "Secrets") — never commit a real key.
local.properties

# Signing keystores. The real release keystore lives outside every git working tree by
# design (see README "Building a signed release"), so nothing here should ever match —
# this is insurance against one being dropped into the project folder by mistake.
*.jks
*.keystore
*.p12

# macOS
.DS_Store

# Internal project docs: they reference this machine's absolute file paths and a private
# cross-project notes repo, neither of which means anything to a stranger cloning this repo,
# and both of which are inappropriate to publish. Kept on disk for local development; never
# tracked. See DECISIONS.md D-012.
AGENTS.md
DECISIONS.md
PROJECT-STATUS.md
HANDOFF.md
